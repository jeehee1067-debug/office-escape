{
  "rules": {
    "v2": {

      "config": {
        ".read": false,
        "adminKey": {
          ".write": "!data.exists()",
          ".validate": "newData.isString() && newData.val().length >= 8"
        },
        "verify": {
          ".write": "root.child('v2/config/adminKey').exists() && newData.child('_k').val() === root.child('v2/config/adminKey').val() && newData.child('at').val() === now"
        }
      },

      "global": {
        ".write": "root.child('v2/config/adminKey').exists() && newData.child('_k/key').val() === root.child('v2/config/adminKey').val() && newData.child('_k/n').val() === now",
        "state": {
          ".read": true,
          "phase":    { ".validate": "newData.val() === 'lobby' || newData.val() === 'playing' || newData.val() === 'results'" },
          "room":     { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 4" },
          "wipeAt":   { ".validate": "newData.val() === now || newData.val() === data.val()" },
          "roomReset": {
            "room": { ".validate": "newData.isString()" },
            "at":   { ".validate": "newData.val() === now || newData.val() === data.val()" }
          }
        }
      },

      "teams": {
        ".write": "root.child('v2/config/adminKey').exists() && newData.child('_k/key').val() === root.child('v2/config/adminKey').val() && newData.child('_k/n').val() === now",
        "state": { ".read": true }
      },

      "bank": {
        ".write": "root.child('v2/config/adminKey').exists() && newData.child('_k/key').val() === root.child('v2/config/adminKey').val() && newData.child('_k/n').val() === now",
        "scores": { ".read": true }
      },

      "players": {
        ".read": true,
        ".write": "!newData.exists() && root.child('v2/global/state/wipeAt').val() > now - 15000",
        "$uid": {
          ".write": "!newData.exists() || newData.child('uid').val() === $uid",
          "name":   { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 12" },
          "avatar": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 32" },
          "loc":    { ".validate": "newData.isString() && newData.val().length <= 8" }
        }
      },

      "runs": {
        ".read": true,
        ".write": "!newData.exists() && root.child('v2/global/state/wipeAt').val() > now - 15000",
        "$uid": {
          "meta": { ".write": true },
          "rooms": {
            "$room": {
              ".write": "!newData.exists() && root.child('v2/global/state/roomReset/room').val() === $room && root.child('v2/global/state/roomReset/at').val() > now - 15000",
              "traps": {
                ".write": true,
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100 && (!data.exists() || newData.val() > data.val())"
              },
              "wrong": {
                "$slot": {
                  ".write": true,
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100 && (!data.exists() || newData.val() > data.val())"
                }
              },
              "solves": {
                "$slot": {
                  ".write": "!data.exists()",
                  ".validate": "newData.hasChildren(['qid', 'points', 'at', 'uid']) && newData.child('uid').val() === $uid && newData.child('qid').isString() && newData.child('qid').val().matches(/^r[1-4][a-z0-9]{1,8}$/) && newData.child('points').isNumber() && newData.child('points').val() === root.child('v2/bank/scores/' + newData.child('qid').val()).val() && newData.child('at').val() === now"
                }
              },
              "done": {
                ".write": "!data.exists()",
                ".validate": "newData.hasChildren(['sec', 'bonus', 'reason', 'at']) && newData.child('sec').isNumber() && newData.child('sec').val() >= 0 && newData.child('sec').val() <= 300 && newData.child('bonus').isNumber() && newData.child('bonus').val() >= 0 && newData.child('bonus').val() <= 3000 && (newData.child('reason').val() === 'cleared' || newData.child('reason').val() === 'timeout') && (newData.child('reason').val() === 'cleared' || newData.child('bonus').val() === 0) && newData.child('at').val() === now"
              }
            }
          }
        }
      },

      "chat": {
        ".read": true,
        ".write": "!newData.exists() && root.child('v2/global/state/wipeAt').val() > now - 15000",
        "global": {
          "$msg": {
            ".write": "!data.exists()",
            ".validate": "newData.hasChildren(['uid', 'text', 'at']) && newData.child('text').isString() && newData.child('text').val().length > 0 && newData.child('text').val().length <= 100 && (!newData.hasChild('name') || newData.child('name').val().length <= 12) && newData.child('at').val() === now"
          }
        },
        "team": {
          "$teamId": {
            "$msg": {
              ".write": "!data.exists()",
              ".validate": "newData.hasChildren(['uid', 'text', 'at']) && newData.child('text').isString() && newData.child('text').val().length > 0 && newData.child('text').val().length <= 100 && (!newData.hasChild('name') || newData.child('name').val().length <= 12) && newData.child('at').val() === now"
            }
          }
        }
      }
    }
  }
}
