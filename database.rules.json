{
  "_comment": [
    "S1FA 방탈출 — Firebase Realtime Database 보안 규칙",
    "Firebase 콘솔 > Realtime Database > 규칙 탭에 그대로 붙여넣고 [게시]하세요.",
    "핵심: (1) 점수/시간 기록은 한 번 쓰면 덮어쓸 수 없다(append-only).",
    "      (2) 게임 진행 제어(global)와 데이터 삭제는 관리자 키를 아는 사람만 가능.",
    "      (3) 관리자 키는 config 노드에 저장되며 클라이언트는 읽을 수 없다."
  ],
  "rules": {
    "v2": {
      "config": {
        ".read": false,
        "adminKey": { ".write": "!data.exists()", ".validate": "newData.isString() && newData.val().length >= 8" },
        "verify": { ".write": "newData.child('_k').val() === root.child('v2/config/adminKey').val()" }
      },

      "global": {
        ".read": true,
        ".write": "!root.child('v2/config/adminKey').exists() || newData.child('_k').val() === root.child('v2/config/adminKey').val()"
      },

      "teams": {
        ".read": true,
        ".write": "!root.child('v2/config/adminKey').exists() || newData.child('_k').val() === root.child('v2/config/adminKey').val()"
      },

      "players": {
        ".read": true,
        ".write": "newData.child('_k').val() === root.child('v2/config/adminKey').val()",
        "$uid": {
          ".write": "$uid === '_k' || !newData.exists() || newData.child('uid').val() === $uid",
          "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 12" },
          "avatar": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 32" }
        }
      },

      "runs": {
        ".read": true,
        ".write": "newData.child('_k').val() === root.child('v2/config/adminKey').val()",
        "$uid": {
          "meta": { ".write": true },
          "rooms": {
            "$room": {
              "traps": { ".write": true, ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
              "wrong": {
                "$slot": {
                  ".write": true,
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100 && (!data.exists() || newData.val() > data.val())"
                }
              },
              "solves": {
                "$slot": {
                  ".write": "!data.exists()",
                  ".validate": "newData.hasChildren(['qid', 'points']) && newData.child('points').isNumber() && newData.child('points').val() >= 0 && newData.child('points').val() <= 12000 && newData.child('at').val() === now"
                }
              },
              "done": {
                ".write": "!data.exists()",
                ".validate": "newData.hasChildren(['sec']) && newData.child('sec').val() >= 0 && newData.child('sec').val() <= 600 && newData.child('bonus').val() >= 0 && newData.child('bonus').val() <= 3000 && newData.child('at').val() === now"
              }
            }
          }
        }
      }
    }
  }
}
